{
    "layer": "top",
    "position": "top",
    "height": 32, 
    "spacing": 0, 
    "margin-top": 0,
    "margin-left": 10,
    "margin-right": 10,

    "modules-left": ["custom/power", "custom/updates", "cpu", "memory", "temperature", "wlr/taskbar"],
    "modules-center": ["hyprland/workspaces", "hyprland/window", "clock"],
    "modules-right": ["network", "bluetooth", "pulseaudio", "battery", "custom/notification"],

    "hyprland/workspaces": {
        "disable-scroll": false,
        "all-outputs": true,
        "format": "{name}", 
        "persistent-workspaces": {
             "*": 5
        },
        "on-scroll-up": "hyprctl dispatch workspace e-1",
        "on-scroll-down": "hyprctl dispatch workspace e+1"
    },

    "hyprland/window": {
        "format": "{class}",
        "max-length": 40,
        "rewrite": {
            "": "Desktop",
            "kitty": "Terminal",
            "Code - OSS": "VS Code"
        }
    },

    "clock": {
        "format": " {:%H:%M   %d %b}", 
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
        "calendar": {
            "mode": "month",
            "mode-mon-col": 3,
            "on-scroll": 1,
            "format": {
                "months": "<span color='#ffffff'><b>{}</b></span>",
                "days": "<span color='#cccccc'>{}</span>",
                "weekdays": "<span color='#ffffff'><b>{}</b></span>",
                "today": "<span color='#000000' background='#ffffff'><b>{}</b></span>"
            }
        },
        "actions": {
            "on-click-right": "mode",
            "on-scroll-up": "shift_up",
            "on-scroll-down": "shift_down"
        }
    },

    "custom/power": {
        "format": "⏻",
        "on-click": "wlogout -c 5 -r 1",
        "tooltip": false
    },
    
    "custom/updates": {
        "format": "󰚰 {}",
        "interval": 720,                     
        "exec": "checkupdates | wc -l",       
        "exec-if": "exit 0",                  
        "on-click": "kitty -e yay -Syu",      
        "signal": 8
    },

    "cpu": { "interval": 2, "format": " {usage}%", "on-click": "kitty btop" },
    "memory": { "interval": 5, "format": " {used:0.1f}G", "on-click": "kitty btop" },
    "temperature": { "critical-threshold": 80, "format": " {temperatureC}°C", "on-click": "kitty btop" },

    "wlr/taskbar": {
        "format": "{icon}",
        "icon-size": 14,
        "tooltip-format": "{title}",
        "on-click": "activate",
        "on-click-middle": "close"
    },

    "network": {
        "format-wifi": " {essid}", 
        "format-ethernet": "󰈀",
        "format-disconnected": "󰤮",
        "tooltip-format": "IP: {ipaddr}\n↓ {bandwidthDownBytes}  ↑ {bandwidthUpBytes}",
        "max-length": 15,
        "on-click": "kitty -e nmtui"
    },

    "bluetooth": {
        "format": "",
        "format-connected": "󰂱 {device_alias}", 
        "format-disabled": "󰂲",
        "tooltip-format": "{device_alias} conectado",
        "max-length": 15,
        "on-click": "blueman-manager"
    },

    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "",
        "format-icons": { "default": ["", "", ""] },
        "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
        "on-click-right": "pavucontrol"
    },
    
    "battery": {
        "states": { "warning": 30, "critical": 15 },
        "format": "{icon} {capacity}%",
        "format-charging": " {capacity}%",
        "format-plugged": " {capacity}%",
        "format-icons": ["", "", "", "", ""]
    },

    "custom/notification": {
        "tooltip": false,
        "format": "",
        "on-click": "swaync-client -t -sw",
        "escape": true
    }
}
